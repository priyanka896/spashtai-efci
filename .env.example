# AWS Region
AWS_REGION=us-east-1

# Temporary S3 bucket for document processing
TEMP_S3_BUCKET=your-bucket-name

# Safety models (Nova Micro primary, Nova Lite fallback)
SAFETY_MODEL_ARN=arn:aws:bedrock:us-east-1::foundation-model/amazon.nova-micro-v1:0
SAFETY_FALLBACK_MODEL_ARN=arn:aws:bedrock:us-east-1::foundation-model/amazon.nova-lite-v1:0

# Explanation models (Nova Lite primary, Nova Pro fallback)
BEDROCK_MODEL_ARN=arn:aws:bedrock:us-east-1::foundation-model/amazon.nova-lite-v1:0
BEDROCK_FALLBACK_MODEL_ARN=arn:aws:bedrock:us-east-1::foundation-model/amazon.nova-pro-v1:0

# DynamoDB cache
DYNAMO_CACHE_TABLE=efci-rag-cache

# CloudWatch audit logs
CLOUDWATCH_LOG_GROUP=/spashtai/efci/audit
CLOUDWATCH_LOG_STREAM=pipeline-runs
